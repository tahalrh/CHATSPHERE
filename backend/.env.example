# Copiez ce fichier en .env et ajustez les valeurs

# Port d'écoute du backend
PORT=3001

# Token secret pour protéger le dashboard admin
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=REMPLACER_PAR_UN_TOKEN_GENERE

# URL du serveur Ollama local
OLLAMA_HOST=http://localhost:11434

# Origine autorisée pour le dashboard (CORS)
DASHBOARD_ORIGIN=http://localhost:5173

# URL publique du backend (utilisée dans les headers OpenRouter)
# En développement, laisser vide ou mettre localhost
# PUBLIC_URL=https://api.monsite.com

# Dossier de stockage de la DB SQLite et des backups
# En développement : laisser vide (utilise le dossier backend/)
# En Docker        : défini automatiquement par docker-compose (/app/data)
# DATA_DIR=/app/data
